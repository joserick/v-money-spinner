{
  "name": "v-money-spinner",
  "version": "2.0.0",
  "description": "A component with input spinner and currency mask.",
  "main": "./dist/v-money-spinner.umd.js",
  "module": "./dist/v-money-spinner.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/v-money-spinner.es.js",
      "require": "./dist/v-money-spinner.umd.js"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.doc.config.ts",
    "build": "vue-tsc && vite build",
    "doc": "vue-tsc && vite build --config vite.doc.config.ts",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joserick/v-money-spinner.git"
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "money",
    "spinner",
    "mask",
    "currency",
    "vue",
    "vue3",
    "input",
    "bootstrap"
  ],
  "author": "Jose Erick Carreon Gomez <joserick.92@gmail.com> (https://github.com/joserick/v-money-spinner)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/joserick/v-money-spinner/issues"
  },
  "homepage": "https://github.com/joserick/v-money-spinner#readme",
  "dependencies": {
    "v-money3": "^3.26.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vue-tsc": "^3.3.11"
  }
}
